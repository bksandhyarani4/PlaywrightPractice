[
  {
    "key": "ctrl+alt+u",
    "command": "workbench.action.tasks.runTask",
    "args": "Toggle AutoSuggest Off",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+i",
    "command": "workbench.action.tasks.runTask",
    "args": "Toggle AutoSuggest On",
    "when": "editorTextFocus"
  }
]
